# Configurações do Banco de Dados PostgreSQL (Neon DB ou Local)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# Configurações da Evolution API (WhatsApp)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_GLOBAL_API_KEY=sua_chave_global
EVOLUTION_INSTANCE=therapist-prod
EVOLUTION_INSTANCE_TOKEN=seu_token_da_instancia

# Configurações de E-mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@exemplo.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=TheraDesk <seu_email@exemplo.com>
